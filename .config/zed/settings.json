{
  "agent_servers": {
    },
  "show_edit_predictions": false,
  "cli_default_open_behavior": "new_window",
  "ui_font_family": "MesloLGL Nerd Font",
  "buffer_font_family": "MesloLGL Nerd Font",
  "terminal": {
    "font_family": "MesloLGL Nerd Font",
  },
  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "git_panel": {
    "group_by": "staging",
    "show_count_badge": true,
    "file_icons": true,
    "tree_view": true,
    "dock": "left",
  },
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "button": true,
    "favorite_models": [],
    "model_parameters": [],
  },
  "project_panel": {
    "git_status_indicator": false,
    "indent_size": 20.0,
    "file_icons": true,
    "entry_spacing": "comfortable",
    "default_width": 240.0,
    "dock": "left",
  },
  "proxy": "",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "base_keymap": "VSCode",
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "VSCode Dark Modern",
  },

  "languages": {
    "Nix": {
      "language_servers": ["nixd"],
    },
  },
  "diagnostics": {
    "inline": {
      // "enabled": true,
      "max_severity": null,
    },
  },
  "load_direnv": "shell_hook",
}
